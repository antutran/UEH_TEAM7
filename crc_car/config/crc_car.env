# UEH CRC 2026 per-car settings. setup_car.sh copies this file to ~/crc_car.env
# once; edit the copy on the car, then run: bash ~/crc_car/scripts/run_car.sh bringup
# (camera settings also need: sudo systemctl restart crc-camera)

# ROS 2 domain shared by the bring-up container and the team container
ROS_DOMAIN_ID=30

# Base (Yahboom ROS board V3.0, JGB37-520 1:30 motors, 65 mm wheels)
CRC_LEFT_MOTOR=1
CRC_RIGHT_MOTOR=4
# Reverse a wheel when positive /cmd_vel turns it backwards (motors mounted mirrored).
# Check per car: turn each wheel forward by hand, /wheel_ticks must count up.
# Measured on the first car (4 Oct 2026): both wheels count down when turned forward.
CRC_LEFT_INVERT=1
CRC_RIGHT_INVERT=1
CRC_WHEEL_SEPARATION=0.298
# Effective wheel radius in metres (65 mm wheels; 1.315 m measured vs 1.29 m odometry -> 0.0331)
CRC_WHEEL_RADIUS=0.0331
CRC_COUNTS_PER_REV=1320
CRC_MAX_PWM=100
# Wheel speed controller (PWM % per rad/s). Tuned on the floor with spin_test.py, 4 Oct 2026:
# 97-104 % of the commanded turn rate. The right wheel needs more PWM than the left.
# Live tuning: ros2 param set /base_driver ff_gain_right 4.8
CRC_KP=2.0
CRC_KI=10.0
# Integrator band in rad/s: 3 limits start-up windup once the feedforward fits this car;
# use 50 (always integrate) on a car whose CRC_FF_GAIN_* are not tuned yet.
CRC_I_BAND=3
CRC_FF_GAIN_LEFT=2.8
CRC_FF_GAIN_RIGHT=4.8
# Speed measurement window (s) and acceleration limits on /cmd_vel (m/s^2, m/s^2, rad/s^2)
CRC_SPEED_WINDOW=0.08
CRC_MAX_ACCEL=0.8
CRC_MAX_DECEL=1.5
CRC_MAX_ANG_ACCEL=6.0

# Camera (IMX219 on CAM0). CAMERA_FLIP: 0 = mounted upright, 2 = upside down
CAMERA_FLIP=2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
# Lens: IMX219-77 -> CAMERA_CROP=1, CRC_CAMERA_HFOV_DEG=62.2
#       IMX219-200 fisheye -> CAMERA_CROP=0.385 (same view as the 77 lens), CRC_CAMERA_HFOV_DEG=62
CAMERA_CROP=1
CRC_CAMERA_HFOV_DEG=62.2

# LiDAR (RPLIDAR C1). Yaw offset = mounting rotation in degrees, counter-clockwise
CRC_LIDAR=1
CRC_SCAN_YAW_OFFSET_DEG=0

# Sign detector (YOLOv5/v8/v11 TensorRT engine built on this car with trtexec; class names in
# a .labels file next to it, one per line). Publishes /signs (vision_msgs/Detection2DArray).
CRC_YOLO=1
CRC_YOLO_ENGINE=/engines/signs.engine
CRC_YOLO_CONF=0.4
CRC_YOLO_RATE=15
