# UEH CRC 2026 per-car settings. setup_car.sh copies this file to ~/crc_car.env
# once; edit the copy on the car, then run: bash ~/crc_car/scripts/run_car.sh bringup
# (camera settings also need: sudo systemctl restart crc-camera)

# ROS 2 domain shared by the bring-up container and the team container
ROS_DOMAIN_ID=6

# Base (Yahboom ROS board V3.0, JGB37-520 1:30 motors, 65 mm wheels)
CRC_LEFT_MOTOR=1
CRC_RIGHT_MOTOR=4
# Both wheels count down when turned forward by hand (measured 4 Oct 2026)
CRC_LEFT_INVERT=1
CRC_RIGHT_INVERT=1
CRC_WHEEL_SEPARATION=0.295
# Effective wheel radius: 1.315 m measured vs 1.29 m odometry (4 Oct 2026)
CRC_WHEEL_RADIUS=0.0331
CRC_COUNTS_PER_REV=1320
CRC_MAX_PWM=100
# Wheel speed controller, tuned on the floor 4 Oct 2026 (spin_test.py: 97-104 %)
CRC_KP=2.0
CRC_KI=10.0
CRC_I_BAND=3
CRC_FF_GAIN_LEFT=2.8
CRC_FF_GAIN_RIGHT=4.8
# Speed measurement window (s) and acceleration limits (tuned 4 Oct 2026)
CRC_SPEED_WINDOW=0.08
CRC_MAX_ACCEL=0.8
CRC_MAX_DECEL=1.5
CRC_MAX_ANG_ACCEL=6.0

# Camera (IMX219 on CAM0). CAMERA_FLIP: 0 = mounted upright, 2 = upside down
CAMERA_FLIP=2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
# IMX219-200 fisheye lens for now: crop to the IMX219-77 view (set 1 and 62.2 after the lens swap)
CAMERA_CROP=0.385
CRC_CAMERA_HFOV_DEG=62

# LiDAR (RPLIDAR C1). Yaw offset = mounting rotation in degrees, counter-clockwise
CRC_LIDAR=1
CRC_SCAN_YAW_OFFSET_DEG=0

# Sign detector (test: COCO yolov5n; switch to signs.engine for the competition)
CRC_YOLO=1
CRC_YOLO_ENGINE=/engines/signs.engine
CRC_YOLO_CONF=0.4
CRC_YOLO_RATE=15
